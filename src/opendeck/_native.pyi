from collections.abc import Callable, Iterable

from .model import Change, Result, Slot
from .ports import Action, Input, Observer, Read, Subject
from .ports import Button as _ButtonContract

type _Definitions = Iterable[tuple[Iterable[Slot], Slot]]
type _Notifications = tuple[Observer, ...]

class InputError(RuntimeError): ...

class Source:
    def __init__(self, capacity: int = 256) -> None: ...
    def start(self) -> None: ...
    def close(self) -> None: ...
    def add(self, observer: Observer, /) -> None: ...
    def remove(self, observer: Observer, /) -> None: ...
    def enqueue(self, item: object, /) -> tuple[bool, _Notifications]: ...
    def record_failure(self, error: str, /) -> _Notifications: ...
    def take(self) -> object | None: ...

class Button(_ButtonContract):
    def read(self) -> bool: ...
    def take(self) -> Change | None: ...
    def add(self, observer: Observer, /) -> None: ...
    def remove(self, observer: Observer, /) -> None: ...

class ReadView(Read[object]):
    def read(self) -> object: ...

class InputView(Input[object]):
    def take(self) -> object | None: ...

class SubjectView(Subject):
    def add(self, observer: Observer, /) -> None: ...
    def remove(self, observer: Observer, /) -> None: ...

def read_view(state: object, /) -> ReadView: ...
def input_view(input: object, /) -> InputView: ...
def subject_view(subject: object, /) -> SubjectView: ...

class Panel:
    def __init__(
        self, slots: Iterable[Slot], chords: _Definitions, capacity: int = 256
    ) -> None: ...
    def start(self) -> None: ...
    def receive(
        self, slot: Slot, pressed: bool, at: float, /
    ) -> tuple[bool, _Notifications]: ...
    def record_failure(self, error: str, /) -> _Notifications: ...
    def close(self, error: str = "Button input closed") -> _Notifications: ...
    @property
    def buttons(self) -> dict[Slot, Button]: ...

class Binding:
    def __init__(self, actions: dict[Slot, Action], /) -> None: ...
    def select(self, slot: Slot, /) -> Action | None: ...

def drain(
    input: Input[Slot],
    binding: Binding,
    report: Callable[[Slot, Result | None], None],
    /,
) -> int: ...
def validate_state(held: Iterable[Slot], claimed: Iterable[Slot], /) -> None: ...
def apply(
    held: Iterable[Slot],
    claimed: Iterable[Slot],
    slot: Slot,
    pressed: bool,
    chords: _Definitions,
    /,
) -> tuple[frozenset[Slot], frozenset[Slot], tuple[Slot, ...]]: ...
def hold(
    held: Iterable[Slot], slot: Slot, pressed: bool, chords: _Definitions, /
) -> tuple[frozenset[Slot], frozenset[Slot]]: ...
def validate_adaptation(slots: Iterable[Slot], chords: _Definitions, /) -> None: ...
